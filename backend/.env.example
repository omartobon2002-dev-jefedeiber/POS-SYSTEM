# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=pos
DB_USER=pos
DB_PASSWORD=pos
DB_HOST=localhost
DB_PORT=5434

# Redis (cache + throttling). Celery is NOT used yet - see ARCHITECTURE.md
REDIS_URL=redis://localhost:6380/0

# Auth
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Web Push (VAPID) — must be URL-safe base64 strings (not Python object reprs).
# Generate with:
#   npx web-push generate-vapid-keys
# Or in the API container (prints only lengths if you adapt the script):
#   docker compose exec api python -c "from py_vapid import Vapid; ..."
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple rejects invalid subjects like mailto:…@*.local — use a real-looking email.
VAPID_SUBJECT=mailto:admin@example.com
