# Variables del backend en producción (Seenode). Cópialas en el panel del
# servicio; NO subas este archivo con valores reales.
DJANGO_SETTINGS_MODULE=config.settings.production
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Dominio del backend, sin https:// (varios separados por coma)
DJANGO_ALLOWED_HOSTS=api.tudominio.com
# Mismo dominio con https:// (para el admin de Django)
CSRF_TRUSTED_ORIGINS=https://api.tudominio.com
# Dominio del frontend con https:// (sin / final)
CORS_ALLOWED_ORIGINS=https://app.tudominio.com
# Se usa en los enlaces de invitación
FRONTEND_URL=https://app.tudominio.com

# Base de datos: o DATABASE_URL (la que da Seenode) o las DB_* sueltas
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
# DB_NAME= DB_USER= DB_PASSWORD= DB_HOST= DB_PORT=5432

# Fotos de productos: ruta dentro del volumen persistente (pestaña Storage)
MEDIA_ROOT=/data/media

# Solo para el primer despliegue: crea el admin de la plataforma. Bórralas luego.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Redis opcional. Vacío = caché en memoria (vale con 1 instancia)
REDIS_URL=
WEB_CONCURRENCY=2

# Notificaciones push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo-real@dominio.com

# Correo (invitaciones / recuperar clave)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
